MONGODB_URL=
MONGODB_DB_NAME=ieum
PORT=8000

# Provider 기본 모델명 (선택 오버라이드 — 변경 시 주석 해제)
CLAUDE_DEFAULT_MODEL=claude-sonnet-5
OPENAI_DEFAULT_MODEL=gpt-5.6-terra
GEMINI_DEFAULT_MODEL=gemini-3.7-flash

# Tavily Search API Key (웹 검색 도구용)
TAVILY_API_KEY=
# 베타 플랫폼 키 모드 (X-Key-Mode: platform). 비어 있으면 비활성.
PLATFORM_GEMINI_API_KEY=

# OpenTelemetry 트레이스 export 대상(OTLP HTTP). 비어 있으면 트레이싱 비활성(no-op).
# 로컬(호스트 uvicorn): http://localhost:6006/v1/traces
# 배포(green_network 컨테이너): http://<PHOENIX_CONTAINER_NAME>:6006/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=

