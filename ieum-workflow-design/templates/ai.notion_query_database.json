    {"name": "prompt", "path": "config.prompt", "required": true, "kind": "string", "description": "DB 조회 지시. database_id 명시. 필터가 필요하면 Notion 필터 객체 JSON을 명시. database_id 미상 시 builtin:notion_search(filter_type=database)로 선행 탐색."}
  ],
  "allowed_config_fields": ["agentType", "credentialId", "tools", "llmProvider", "prompt", "systemMessage", "model", "serviceType"],
